{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "prebuild": "pnpm --filter mobile-devtools build",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "pnpm build && wrangler pages deploy dist",
    "preview:pages": "wrangler pages dev dist"
  },
  "dependencies": {
    "mobile-devtools": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@mobile-devtools/eslint-config": "workspace:*",
    "@mobile-devtools/tsconfig": "workspace:*",
    "@mobile-devtools/vite-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.39.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "^3.109.0"
  }
}
